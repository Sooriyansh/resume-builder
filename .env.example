# MongoDB connection string (MongoDB Atlas is recommended for production)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER_HOST/DATABASE?retryWrites=true&w=majority"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI or an OpenAI-compatible provider
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_CHAT_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Use "local" only in development. Vercel production must use "supabase".
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="private-resumes"
