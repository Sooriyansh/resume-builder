# Local SQLite database (stored at prisma/local.db)
DATABASE_URL="file:./local.db"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI or an OpenAI-compatible provider
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_CHAT_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# "local" for development or "supabase" for private production storage
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="private-resumes"
