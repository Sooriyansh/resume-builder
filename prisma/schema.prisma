generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  resumes         Resume[]
  jobDescriptions JobDescription[]
  analyses        Analysis[]
  resumeChunks    ResumeChunk[]
  usageRecords    UsageRecord[]
  builderResumes  BuilderResume[]
}

model BuilderResume {
  id          String   @id @default(cuid())
  userId      String
  title       String
  template    String   @default("modern")
  data        Json
  settings    Json
  shareToken  String?  @unique
  shareEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ExportFeedback {
  id              String   @id @default(cuid())
  name            String
  rating          Int
  builderResumeId String?
  resumeTitle     String?
  source          String   @default("builder")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([builderResumeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id                 String        @id @default(cuid())
  userId             String
  originalFilename   String
  storagePath        String
  mimeType           String
  fileSize           Int
  extractedText      String?
  parsedData         Json?
  extractionWarnings Json?
  status             String        @default("UPLOADED")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks             ResumeChunk[]
  analyses           Analysis[]
  chatSessions       ChatSession[]

  @@index([userId, createdAt])
}

model JobDescription {
  id          String     @id @default(cuid())
  userId      String
  title       String?
  companyName String?
  rawText     String
  parsedData  Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    Analysis[]

  @@index([userId, createdAt])
}

model Analysis {
  id               String              @id @default(cuid())
  userId           String
  resumeId         String
  jobDescriptionId String
  overallScore     Int
  verdict          String
  scoreBreakdown   Json
  result           Json
  modelName        String
  promptVersion    String              @default("1.0")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume              @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription   JobDescription      @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  chatSessions     ChatSession[]

  @@index([userId, createdAt])
  @@index([userId, overallScore])
  @@index([userId, verdict])
}

model ResumeChunk {
  id             String   @id @default(cuid())
  userId         String
  resumeId       String
  content        String
  section        String
  chunkIndex     Int
  embedding      String?
  embeddingModel String
  contentHash    String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, contentHash, embeddingModel])
  @@index([userId, resumeId])
}

model ChatSession {
  id         String        @id @default(cuid())
  userId     String
  resumeId   String
  analysisId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  resume     Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  analysis   Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([userId, analysisId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  role          String
  content       String
  sources       Json?
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id            String   @id @default(cuid())
  userId        String
  action        String
  tokenEstimate Int
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
